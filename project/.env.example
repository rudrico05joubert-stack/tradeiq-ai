# Browser-safe Supabase configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-side API configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5.1

# Server-only payment configuration (never prefix these with VITE_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
PAYSTACK_SECRET_KEY=sk_test_your-key
PAYSTACK_PRO_PLAN_CODE=PLN_your-pro-plan
PAYSTACK_ELITE_PLAN_CODE=PLN_your-elite-plan
PAYSTACK_CALLBACK_URL=https://www.nexoracharts.com/?payment=callback

# Optional when the API is hosted separately from the web app
# VITE_API_BASE_URL=https://api.example.com
